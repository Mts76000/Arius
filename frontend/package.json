{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "build:apk": "pnpm dlx eas-cli build -p android --profile apk",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --ios --localhost --port 8084 --clear",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:serve": "serve dist -s -l 8084",
    "lint": "eslint app components hooks services store utils shared",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm web:export && playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "types:api": "openapi-typescript ../shared/openapi.json -o shared/openapiTypes.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "~55.0.6",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.17.0",
    "babel-preset-expo": "^55.0.11",
    "expo": "~55.0.26",
    "expo-constants": "~55.0.16",
    "expo-document-picker": "^55.0.13",
    "expo-font": "~55.0.8",
    "expo-image-picker": "^55.0.20",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "0.2.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.4",
    "react-test-renderer": "^19.2.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
